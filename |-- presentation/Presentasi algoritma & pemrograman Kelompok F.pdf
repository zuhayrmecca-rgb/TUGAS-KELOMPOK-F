/P 133 0 R
/T ( OUTPUT "Masukkan ukuran sampel \(n\): "  INPUT n  error_margin <- z * SQRT\(\(p_topi * \(1 - p_topi\)\) / n\)  batas_bawah<- p_topi - error_margin  batas_atas<- p_topi + error_margin)
/E ( OUTPUT "Masukkan ukuran sampel \(n\): "  INPUT n  error_margin <- z * SQRT\(\(p_topi * \(1 - p_topi\)\) / n\)  batas_bawah<- p_topi - error_margin  batas_atas<- p_topi + error_margin)
/Pg 21 0 R
/K [23]
>>
endobj
